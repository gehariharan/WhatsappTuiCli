# Optional shared data directory; shell-expand your desired absolute path.
# This file is documentation, not automatically loaded by wasync.
# WASYNC_DATA_DIR=/absolute/path/to/private/wasync
# The command timeout is set with: wasync --timeout 5m COMMAND

# Optional literal loopback API address (TUI and serve).
# WASYNC_API_ADDR=127.0.0.1:8787
# Disable the API alongside the TUI using: wasync --no-api
