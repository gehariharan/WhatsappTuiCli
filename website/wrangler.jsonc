{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "wasync-site",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "routes": [
    { "pattern": "gehariharan.com/wasync", "zone_name": "gehariharan.com" },
    { "pattern": "gehariharan.com/wasync/*", "zone_name": "gehariharan.com" },
    { "pattern": "www.gehariharan.com/wasync", "zone_name": "gehariharan.com" },
    { "pattern": "www.gehariharan.com/wasync/*", "zone_name": "gehariharan.com" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/wasync/releases.json", "/wasync/download/*"]
  }
}
